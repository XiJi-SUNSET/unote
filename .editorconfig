root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{java,kt,kts,gradle}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf
